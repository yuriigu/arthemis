# Copie para .env na raiz somente se quiser sobrescrever os defaults do Compose.
# O Compose já possui defaults development-safe para subir sem este arquivo.

# Credenciais do PostgreSQL (serviço `db`).
POSTGRES_USER=arthemis_user
POSTGRES_PASSWORD=arthemis_password
POSTGRES_DB=arthemis_db

# Autenticação JWT usada pelo backend (`JWT_SECRET` mínimo de 32 caracteres).
JWT_SECRET=arthemis-dev-only-jwt-secret-change-me-9f4b7e2a-0123456789
JWT_EXPIRES_IN=24h

# Porta do host do backend. A porta interna do container é sempre 8081;
# HTTP do frontend na rede interna usa backend:8081.
API_PORT=8081

# URL pública do proxy HTTP do frontend, vista pelo navegador.
NEXT_PUBLIC_API_URL=http://localhost:3000/api
