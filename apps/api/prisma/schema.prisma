// Schema Prisma da API do Arthemis.
//
// A connection string fica em prisma.config.ts, seguindo o padrão do Prisma 7.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Usuário da API do Arthemis.
///
/// Mapeamento herdado de `legacy/brain/internal/models/user.go` e
/// `legacy/edge/services/auth/models/i_user.go`:
/// - PK em UUID, como a claim `sub` do JWT gerado pelo edge/services/auth;
/// - `email` em varchar(150) único (credencial de login neste novo fluxo);
/// - `role` em varchar(20) com default 'visitor' e CHECK no banco
///   (admin | manager | visitor), igual ao `check:role IN (...)` do gorm;
/// - hash de senha em varchar(255) (o bcrypt produz 60 caracteres).
///
/// Fora do escopo desta task (chegam depois): `proponent_id` (depende do model
/// Proponent) e `username` (substituído pelo e-mail como identidade).
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @default("visitor") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

