generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  manager
  visitor
}

model Proponent {
  id                Int                @id @default(autoincrement())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  name              String
  email             String
  users             User[]
  projects          Project[]
  projectProponents ProjectProponent[]
}

model User {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  proponentId Int
  proponent   Proponent @relation(fields: [proponentId], references: [id], onDelete: Cascade)
  username    String    @unique
  email       String    @unique
  password    String
  role        UserRole  @default(visitor)
}

model Project {
  id                Int                @id @default(autoincrement())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  proponentId       Int
  proponent         Proponent          @relation(fields: [proponentId], references: [id], onDelete: Cascade)
  name              String
  lifetimeStart     DateTime?
  lifetimeEnd       DateTime?
  justification     String?
  locations         Location[]
  activities        Activity[]
  projectProponents ProjectProponent[]
}

model ProjectProponent {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  proponentId Int
  proponent   Proponent @relation(fields: [proponentId], references: [id], onDelete: Cascade)
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role        String
}

model Location {
  id         Int         @id @default(autoincrement())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  projectId  Int
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ecosystem  String?
  extent     Float?
  country    String?
  position   Json?
  indicators Indicator[]
  activities Activity[]  @relation("ActivityLocations")
}

model Activity {
  id            Int        @id @default(autoincrement())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  projectId     Int
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  justification String?
  locations     Location[] @relation("ActivityLocations")
  indicators    Indicator[]
}

model Indicator {
  id                Int           @id @default(autoincrement())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  activityId        Int
  activity          Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  locationId        Int?
  location          Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name              String
  unit              String?
  valueBaseline     Float?
  valueReference    Float?
  observationMethod String?
  justification     String?
  observations      Observation[]
}

model Observation {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  indicatorId Int
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  value       Float
  date        DateTime
  position    Json?
}
