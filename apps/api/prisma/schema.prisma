// Schema Prisma da API do Arthemis.
//
// A connection string fica em prisma.config.ts, seguindo o padrão do Prisma 7.
//
// Modelagem herdada de `legacy/brain/internal/models/*.go` (tabelas criadas pelo
// `AutoMigrate` do gorm) e consumida pelo `legacy/watcher/internal/models/brain.go`.
// As decisões de modernização (UUID no lugar de uint, `created_at/updated_at/
// deleted_at` explícitos no lugar do `gorm.Model`) estão documentadas em cada
// model. Os nomes físicos das tabelas continuam iguais aos do legado via `@@map`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Statuses in the SD-VISta project lifecycle.
enum ProjectStatus {
  Draft
  Listed
  Under_Assessment
  Verified
}

/// Usuário da API do Arthemis.
///
/// Mapeamento herdado de `legacy/brain/internal/models/user.go` e
/// `legacy/edge/services/auth/models/i_user.go`:
/// - PK em UUID, como a claim `sub` do JWT gerado pelo edge/services/auth;
/// - `email` em varchar(150) único (credencial de login neste novo fluxo);
/// - `role` em varchar(20) com default 'visitor' e CHECK no banco
///   (admin | manager | visitor), igual ao `check:role IN (...)` do gorm;
/// - hash de senha em varchar(255) (o bcrypt produz 60 caracteres).
///
/// Campos reativados por esta task, com paridade ao legado:
/// - `username` em varchar(150) único (o `Username` do gorm). É **opcional** no
///   banco porque o `POST /users` atual cria o usuário apenas com e-mail/senha e
///   o seed de desenvolvimento não informa username; assim o fluxo existente
///   continua válido. A unicidade é a mesma do legado (uniqueIndex);
/// - `organizationId` com o relacionamento `User -> Organization`.
///
/// Diferença consciente do legado: lá `OrganizationID` era `not null` com
/// `OnDelete:CASCADE`; aqui o relacionamento é **opcional** (requisito da task),
/// então a FK usa `onDelete: SetNull` para não apagar o usuário quando o
/// organização for removida.
///
/// Sem soft delete de propósito: o `User` legado **não** embute `gorm.Model`
/// (`ID`/`Email`/`Role` são declarados direto na struct), logo não havia
/// `deleted_at`. Manter a paridade estrita = não adicionar `deletedAt` aqui.
model User {
  id             String        @id @default(uuid()) @db.Uuid
  username       String?       @unique @db.VarChar(150)
  email          String        @unique @db.VarChar(150)
  passwordHash   String        @map("password_hash") @db.VarChar(255)
  role           String        @default("visitor") @db.VarChar(20)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@map("users")
}

/// Organização de um projeto (tabela `organizations` do legado, criada
/// a partir de `BrainOrganization`/`models.Organization`).
///
/// - PK em UUID (era o `uint` do gorm);
/// - `name`/`email` sem tamanho no gorm (`text`) — mantidos como `Text` por
///   paridade; `email` **não** é único (o legado só exigia `not null`);
/// - soft delete (`deletedAt`) + `createdAt`/`updatedAt`, equivalentes ao
///   `gorm.Model` (CreatedAt/UpdatedAt/DeletedAt).
model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.Text
  email     String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  projects             Project[]
  projectOrganizations ProjectOrganization[]
  users                User[]

  @@map("organizations")
}

/// Projeto socioambiental (tabela `projects` do legado, criada a partir de
/// `BrainProject`/`models.Project`).
///
/// - PK em UUID (era o `uint` do gorm);
/// - `name` em varchar(150) `not null` (igual ao gorm);
/// - `lifetime_start`/`lifetime_end` em `date` (o gorm declarava `type:date`);
/// - `justification` em `text`;
/// - soft delete (`deletedAt`) + timestamps equivalentes ao `gorm.Model`.
///
/// Diferença consciente do legado: lá `OrganizationID` era `not null` sem FK
/// explícita. Aqui a FK para `organizations` é `onDelete: Restrict` para impedir
/// apagar uma organização que ainda tem projetos (o legado não tinha FK e podia
/// deixar projeto órfão).
model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String        @db.VarChar(150)
  status         ProjectStatus @default(Draft)
  lifetimeStart  DateTime?     @map("lifetime_start") @db.Date
  lifetimeEnd    DateTime?     @map("lifetime_end") @db.Date
  justification  String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projectOrganizations ProjectOrganization[]
  projectSdgs          ProjectSdg[]
  activities           Activity[]
  locations            Location[]

  @@index([organizationId])
  @@index([name])
  @@map("projects")
}

/// Activity belonging to a project, with indicators and linked locations.
model Activity {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  name          String    @db.VarChar(100)
  description   String?   @db.Text
  justification String?   @db.Text
  startDate     DateTime? @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  indicators        Indicator[]
  activityLocations ActivityLocation[]

  @@index([projectId])
  @@map("activities")
}

/// Join record for the legacy Activity <-> Location many-to-many relation.
model ActivityLocation {
  id         String    @id @default(uuid()) @db.Uuid
  activityId String    @map("activity_id") @db.Uuid
  locationId String    @map("location_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([activityId, locationId])
  @@index([locationId])
  @@map("activity_locations")
}

/// Indicator attached to an activity and a location.
model Indicator {
  id                String    @id @default(uuid()) @db.Uuid
  activityId        String    @map("activity_id") @db.Uuid
  locationId        String    @map("location_id") @db.Uuid
  name              String    @db.VarChar(100)
  unit              String?   @db.VarChar(50)
  valueBaseline     Float     @map("value_baseline")
  valueReference    Float     @map("value_reference")
  observationMethod String?   @map("observation_method") @db.Text
  justification     String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  activity     Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  observations Observation[]

  @@index([activityId])
  @@index([locationId])
  @@map("indicators")
}

/// Geographic area attached to a project.
model Location {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.Text
  ecosystem   String    @db.VarChar(100)
  extent      Float
  country     String    @db.VarChar(100)
  position    Json?     @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  indicators        Indicator[]
  activityLocations ActivityLocation[]

  @@index([projectId])
  @@map("locations")
}

/// Measurement recorded for an indicator.
model Observation {
  id          String    @id @default(uuid()) @db.Uuid
  indicatorId String    @map("indicator_id") @db.Uuid
  value       Float
  date        DateTime  @db.Date
  position    Json?     @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([indicatorId])
  @@map("observations")
}

/// Vínculo N:N entre projeto e organização com o papel exercido (tabela
/// `project_organizations` do legado, de `models.ProjectOrganization`).
///
/// - PK em UUID (era o `uint` do gorm) e unique composta `(projectId,
///   organizationId)` — o requisito de não repetir o mesmo par no projeto;
/// - `role` em varchar(50) (igual ao gorm);
/// - soft delete (`deletedAt`) + timestamps (paridade com o `gorm.Model`).
///
/// FKs em `onDelete: Cascade`: o vínculo não faz sentido sem o projeto ou o
/// organização (o legado não declarava FK; aqui a integridade é explícita).
model ProjectOrganization {
  id             String    @id @default(uuid()) @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  role           String?   @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, organizationId])
  @@index([organizationId])
  @@map("project_organizations")
}

/// Objetivo de Desenvolvimento Sustentável (ODS) da ONU (tabela `sdgs` do
/// legado, de `BrainSdgs`/`models.Sdg`).
///
/// - PK em UUID (era o `uint` do gorm);
/// - `number` é único (1..17) e é a chave natural usada pelo seed idempotente;
/// - `name`/`icon_url` sem tamanho no gorm (`text`) — mantidos por paridade;
/// - soft delete (`deletedAt`) + timestamps (paridade com o `gorm.Model`).
model Sdg {
  id        String    @id @default(uuid()) @db.Uuid
  number    Int       @unique
  name      String    @db.Text
  iconUrl   String    @map("icon_url") @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  projectSdgs ProjectSdg[]

  @@map("sdgs")
}

/// Vínculo N:N entre projeto e ODS (tabela `project_sdg` do legado, de
/// `BrainProjectSdgs`).
///
/// - PK em UUID (o legado usava PK composta; aqui a PK é o UUID e a unicidade
///   do par vive na `@@unique([projectId, sdgId])`, exatamente como pedido);
/// - soft delete (`deletedAt`) + timestamps. O legado **não** tinha soft delete
///   nesta tabela (não embutia `gorm.Model`), mas o requisito manda manter a
///   paridade de soft delete em todas as entidades de domínio — por isso o
///   campo entra aqui também;
/// - FKs em `onDelete: Cascade`.
model ProjectSdg {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  sdgId     String    @map("sdg_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sdg     Sdg     @relation(fields: [sdgId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, sdgId])
  @@index([sdgId])
  @@map("project_sdg")
}
