# ---------------------------------------------------------------------------
# Arthemis API - variáveis de ambiente
#
# Copie este arquivo para .env antes de rodar a aplicação:
#   cp .env.example .env
#
# O .env não é versionado (veja o .gitignore). A validação acontece no boot:
# se uma variável obrigatória estiver ausente, a API não sobe (fail-fast).
# ---------------------------------------------------------------------------

# Ambiente de execução: development | test | production (default: development)
NODE_ENV=development

# Porta HTTP da API. O default é 8081 para manter a compatibilidade com o
# gateway Traefik legado (serviço `brain` apontava para brain:8081).
PORT=8081

# Nome do serviço retornado no campo "service" do GET /healthcheck.
SERVICE_NAME=arthemis-api

# ---------------------------------------------------------------------------
# Credenciais do container PostgreSQL (obrigatórias para o docker-compose.yml).
# O Compose lê este arquivo automaticamente; sem elas o `docker compose up`
# falha com uma mensagem explícita.
# ---------------------------------------------------------------------------
POSTGRES_USER=arthemis_user
POSTGRES_PASSWORD=arthemis_password
POSTGRES_DB=arthemis_db

# ---------------------------------------------------------------------------
# Conexão usada pela API (Prisma) - OBRIGATÓRIA.
# Precisa apontar para o mesmo banco/credenciais dos POSTGRES_* acima.
# Host: use `localhost` quando a API roda na máquina e o banco no Docker;
# use o nome do serviço (`postgres`) quando a API também rodar no Compose.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://arthemis_user:arthemis_password@localhost:5432/arthemis_db?schema=public"

# ---------------------------------------------------------------------------
# Autenticação JWT - OBRIGATÓRIAS (fail-fast: sem JWT_SECRET a API não sobe).
#
# JWT_SECRET: segredo de assinatura HS256 do access_token. Mínimo de 32
# caracteres. Gere um novo por ambiente:
#   openssl rand -base64 48
# NUNCA use o valor de exemplo abaixo em produção.
# JWT_EXPIRES_IN: validade do token no formato aceito pelo jsonwebtoken
# (ex.: 15m, 24h, 7d). Default: 24h (mesma janela do auth legado).
# ---------------------------------------------------------------------------
JWT_SECRET=arthemis-dev-only-jwt-secret-change-me-9f4b7e2a-0123456789
JWT_EXPIRES_IN=24h

# ---------------------------------------------------------------------------
# Seed de desenvolvimento (npm run prisma:seed) - todas OPCIONAIS.
# Sem estas variáveis o seed usa admin@arthemis.local / arthemis-dev-123 (admin)
# e recusa rodar com NODE_ENV=production enquanto a senha default estiver em uso.
# ---------------------------------------------------------------------------
# SEED_USER_EMAIL=admin@arthemis.local
# SEED_USER_PASSWORD=arthemis-dev-123
# SEED_USER_ROLE=admin
